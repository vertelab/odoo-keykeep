<odoo>
    <data noupdate="1">
        <!-- Security Groups -->
        <record id="module_category_keykeep" model="ir.module.category">
            <field name="name">Keykeep</field>
            <field name="sequence">100</field>
        </record>

        <record id="group_user" model="res.groups">
            <field name="name">Keykeep User</field>
            <field name="category_id" ref="module_category_keykeep"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can view own subscriptions and receive notifications.</field>
        </record>

        <record id="group_manager" model="res.groups">
            <field name="name">Keykeep Manager</field>
            <field name="category_id" ref="module_category_keykeep"/>
            <field name="implied_ids" eval="[(4, ref('group_user')), (4, ref('account.group_account_invoice'))]"/>
            <field name="comment">Can manage all subscriptions and view financial data.</field>
        </record>

        <record id="group_admin" model="res.groups">
            <field name="name">Keykeep Admin</field>
            <field name="category_id" ref="module_category_keykeep"/>
            <field name="implied_ids" eval="[(4, ref('group_manager'))]"/>
            <field name="comment">Can view and manage encrypted credentials.</field>
        </record>
    </data>
</odoo>
