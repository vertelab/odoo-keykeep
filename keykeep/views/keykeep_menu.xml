<odoo>
    <!-- Main Menu Items -->
    <menuitem id="menu_keykeep_root"
              name="Keykeep"
              web_icon="keykeep,static/description/icon.png"
              sequence="70"/>

    <!-- Suppliers — FÖRST i huvudmenyn. Självförsörjande i keykeep:
         Suppliers-aktionen använder keykeep-partnerfältet is_keykeep_partner
         (inget beroende av bifrost_keykeep-bryggan). Subscriptions ligger här
         som barn. -->
    <menuitem id="menu_keykeep_suppliers"
              name="Suppliers"
              parent="menu_keykeep_root"
              sequence="10"/>

    <menuitem id="menu_keykeep_supplier_list"
              name="Suppliers"
              parent="menu_keykeep_suppliers"
              sequence="10"
              action="action_keykeep_suppliers"/>

    <menuitem id="menu_keykeep_subscriptions"
              name="Subscriptions"
              parent="menu_keykeep_suppliers"
              sequence="20"
              action="action_keykeep_subscription"/>

    <!-- Forecast — pivot, graph, list (under Keykeep root) -->
    <menuitem id="menu_keykeep_forecast"
              name="Forecast"
              parent="menu_keykeep_root"
              sequence="30"
              action="action_keykeep_cost_forecast"/>

    <!-- Configuration — SIST i huvudmenyn (Odoo-standard) -->
    <menuitem id="menu_keykeep_config"
              name="Configuration"
              parent="menu_keykeep_root"
              sequence="90"
              groups="keykeep.group_manager"/>

    <!-- Settings — FÖRST i Configuration -->
    <menuitem id="menu_keykeep_settings"
              name="Settings"
              parent="menu_keykeep_config"
              sequence="10"
              action="action_keykeep_settings"/>

    <menuitem id="menu_keykeep_category"
              name="Categories"
              parent="menu_keykeep_config"
              action="action_keykeep_category"
              sequence="20"/>

    <menuitem id="menu_keykeep_payment_method"
              name="Payment Methods"
              parent="menu_keykeep_config"
              action="action_keykeep_payment_method"
              sequence="30"/>
</odoo>
