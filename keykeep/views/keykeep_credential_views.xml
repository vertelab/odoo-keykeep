<odoo>
    <!-- Credential Tree View -->
    <record id="view_keykeep_credential_tree" model="ir.ui.view">
        <field name="name">keykeep.credential.tree</field>
        <field name="model">keykeep.credential</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="credential_type"/>
                <field name="username"/>
                <field name="purpose"/>
                <field name="expiry_date"/>
                <field name="subscription_id" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Credential Form View -->
    <record id="view_keykeep_credential_form" model="ir.ui.view">
        <field name="name">keykeep.credential.form</field>
        <field name="model">keykeep.credential</field>
        <field name="arch" type="xml">
            <form string="Credential">
                <header>
                    <button name="action_reveal_password" type="object"
                            string="Reveal" class="btn-warning"
                            groups="keykeep.group_admin"
                            help="Reveal the decrypted password/key"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Admin Login, Production API Key"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="subscription_id" readonly="1"/>
                            <field name="credential_type"/>
                            <field name="purpose"/>
                        </group>
                        <group>
                            <field name="expiry_date"/>
                            <field name="renewal_reminder"/>
                        </group>
                    </group>
                    <group string="Credentials" invisible="credential_type == 'certificate'">
                        <group>
                            <field name="username" invisible="credential_type != 'login' and credential_type != 'other'"/>
                        </group>
                    </group>
                    <group string="Key Details" invisible="credential_type != 'api_key' and credential_type != 'token' and credential_type != 'other'">
                        <group>
                            <field name="key_value" widget="text" placeholder="Paste your API key or token here..."/>
                        </group>
                    </group>
                    <group string="Login Details" invisible="credential_type != 'login'">
                        <group>
                            <field name="password" password="True" placeholder="Password (encrypted)"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
