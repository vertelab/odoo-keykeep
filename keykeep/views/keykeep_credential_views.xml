<odoo>
    <!-- Credential Tree View -->
    <record id="view_keykeep_credential_tree" model="ir.ui.view">
        <field name="name">keykeep.credential.tree</field>
        <field name="model">keykeep.credential</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="subscription_id"/>
                <field name="environment"/>
                <field name="credential_type"/>
                <field name="username" optional="show"/>
                <field name="purpose" optional="show"/>
                <field name="expiry_date"
                       decoration-danger="expiry_date and expiry_date &lt; context_today()"
                       decoration-warning="expiry_date and (expiry_date - context_today()).days &lt;= 30"/>
                <field name="rotation_age" optional="show"
                       decoration-warning="rotation_age &gt; 90"/>
                <field name="last_accessed_at" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Credential Form View -->
    <record id="view_keykeep_credential_form" model="ir.ui.view">
        <field name="name">keykeep.credential.form</field>
        <field name="model">keykeep.credential</field>
        <field name="arch" type="xml">
            <form string="Credential">
                <header>
                    <button name="action_reveal_password" type="object"
                            string="Reveal" class="btn-warning"
                            groups="keykeep.group_devops,keykeep.group_admin"
                            help="Reveal the decrypted password/key"/>
                    <field name="environment" widget="badge"
                           decoration-success="environment == 'production'"
                           decoration-warning="environment == 'staging'"
                           decoration-info="environment == 'development'"
                           decoration-muted="environment == 'testing'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Admin Login, Production API Key"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="subscription_id" readonly="1"/>
                            <field name="credential_type"/>
                            <field name="environment"/>
                            <field name="purpose"/>
                        </group>
                        <group>
                            <field name="expiry_date"/>
                            <field name="renewal_reminder"/>
                            <field name="rotation_age" widget="integer"
                                   help="Days since this credential was last updated."/>
                            <field name="last_accessed_at"
                                   help="When this credential was last revealed or copied."/>
                        </group>
                    </group>
                    <group string="Credentials" invisible="credential_type == 'certificate'">
                        <group>
                            <field name="username" invisible="credential_type != 'login' and credential_type != 'other'"/>
                        </group>
                    </group>
                    <group string="Key Details" invisible="credential_type != 'api_key' and credential_type != 'token' and credential_type != 'other'">
                        <group>
                            <field name="key_value" widget="text" placeholder="Paste your API key or token here..."/>
                        </group>
                    </group>
                    <group string="Login Details" invisible="credential_type != 'login'">
                        <group>
                            <field name="password" password="True" placeholder="Password (encrypted)"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Version History Tab -->
                        <page string="Version History" name="versions"
                              groups="keykeep.group_devops,keykeep.group_admin,keykeep.group_manager">
                            <field name="version_ids" nolabel="1"
                                   mode="tree"/>
                        </page>
                        <!-- Access Log Tab -->
                        <page string="Access Log" name="access_log"
                              groups="keykeep.group_devops,keykeep.group_admin">
                            <field name="access_log_ids" nolabel="1"
                                   mode="tree"/>
                        </page>
                        <!-- Notes Tab -->
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Version Tree View for use in credential form -->
    <record id="view_keykeep_credential_version_tree" model="ir.ui.view">
        <field name="name">keykeep.credential.version.tree</field>
        <field name="model">keykeep.credential.version</field>
        <field name="arch" type="xml">
            <list>
                <field name="version_number"/>
                <field name="changed_at"/>
                <field name="changed_by"/>
                <field name="change_note"/>
            </list>
        </field>
    </record>

    <!-- Version Form View -->
    <record id="view_keykeep_credential_version_form" model="ir.ui.view">
        <field name="name">keykeep.credential.version.form</field>
        <field name="model">keykeep.credential.version</field>
        <field name="arch" type="xml">
            <form string="Credential Version">
                <header>
                    <button name="action_reveal_value" type="object"
                            string="Reveal Value" class="btn-warning"
                            groups="keykeep.group_devops,keykeep.group_admin"
                            help="View the decrypted value from this historical version"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="credential_id"/>
                            <field name="version_number"/>
                            <field name="changed_by"/>
                            <field name="changed_at"/>
                        </group>
                        <group>
                            <field name="username"/>
                            <field name="change_note"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Access Log Tree View -->
    <record id="view_keykeep_credential_access_log_tree" model="ir.ui.view">
        <field name="name">keykeep.credential.access.log.tree</field>
        <field name="model">keykeep.credential.access.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="accessed_at"/>
                <field name="credential_id"/>
                <field name="subscription_id"/>
                <field name="user_id"/>
                <field name="action"/>
                <field name="fields_accessed"/>
                <field name="ip_address"/>
            </list>
        </field>
    </record>

    <!-- Access Log Search View -->
    <record id="view_keykeep_credential_access_log_search" model="ir.ui.view">
        <field name="name">keykeep.credential.access.log.search</field>
        <field name="model">keykeep.credential.access.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="credential_id"/>
                <field name="subscription_id"/>
                <field name="user_id"/>
                <separator/>
                <filter name="action_reveal" string="Reveals"
                        domain="[('action', 'in', ('reveal', 'reveal_version'))]"/>
                <filter name="action_copy" string="Copies"
                        domain="[('action', '=', 'copy')]"/>
                <filter name="action_rotate" string="Rotations"
                        domain="[('action', '=', 'rotate')]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('accessed_at', '&gt;=', context_today().strftime('%%Y-%%m-%%d 00:00:00'))]"/>
                <filter name="this_week" string="This Week"
                        domain="[('accessed_at', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%%Y-%%m-%%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_user" string="User"
                            domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter name="group_action" string="Action"
                            domain="[]" context="{'group_by': 'action'}"/>
                    <filter name="group_subscription" string="Subscription"
                            domain="[]" context="{'group_by': 'subscription_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Audit Report Action (Access Log) -->
    <record id="action_keykeep_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">keykeep.credential.access.log</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_keykeep_credential_access_log_search"/>
        <field name="domain">[]</field>
    </record>
</odoo>
