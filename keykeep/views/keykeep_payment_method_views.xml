<odoo>
    <!-- Payment Method Tree View -->
    <record id="view_keykeep_payment_method_tree" model="ir.ui.view">
        <field name="name">keykeep.payment.method.tree</field>
        <field name="model">keykeep.payment.method</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="method_type"/>
                <field name="card_last_four"/>
            </list>
        </field>
    </record>

    <!-- Payment Method Form View -->
    <record id="view_keykeep_payment_method_form" model="ir.ui.view">
        <field name="name">keykeep.payment.method.form</field>
        <field name="model">keykeep.payment.method</field>
        <field name="arch" type="xml">
            <form string="Payment Method">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Company VISA Card"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="method_type"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Card Details" invisible="method_type != 'card'">
                        <group>
                            <field name="card_holder_name"/>
                            <field name="card_last_four"/>
                            <field name="card_expiry_date"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Payment Method Action -->
    <record id="action_keykeep_payment_method" model="ir.actions.act_window">
        <field name="name">Payment Methods</field>
        <field name="res_model">keykeep.payment.method</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
    </record>
</odoo>
