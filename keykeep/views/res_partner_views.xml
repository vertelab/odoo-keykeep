<odoo>

    <!-- KeyKeep checkbox in the standard form — anchored on the base field company_type
         (independent of bifrost/bifrost_keykeep). -->
    <record id="view_partner_keykeep_checkbox" model="ir.ui.view">
        <field name="name">res.partner.keykeep.checkbox</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="company_type" position="after">
                <div class="o_row">
                    <field name="is_keykeep_partner"/>
                    <label for="is_keykeep_partner" string="KeyKeep"/>
                </div>
            </field>
        </field>
    </record>

    <!-- ==================================================================
         Suppliers — self-sufficient in keykeep (independent of the
         bifrost_keykeep bridge). Shows partners where is_keykeep_partner
         is set, using only keykeep's own fields (base + keykeep).
         ================================================================== -->

    <!-- Suppliers list -->
    <record id="view_keykeep_supplier_list" model="ir.ui.view">
        <field name="name">res.partner.keykeep.supplier.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Suppliers">
                <field name="name" string="Supplier"/>
                <field name="email"/>
                <field name="is_keykeep_partner" string="KeyKeep"/>
                <field name="subscription_count" string="Subscriptions"/>
            </list>
        </field>
    </record>

    <!-- Suppliers form (self-sufficient: base partner fields + keykeep fields) -->
    <record id="view_keykeep_supplier_form" model="ir.ui.view">
        <field name="name">res.partner.keykeep.supplier.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Supplier">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_subscriptions" type="object"
                                class="oe_stat_button" icon="fa-list-alt">
                            <div class="o_stat_info">
                                <field name="subscription_count"/>
                                <span class="o_stat_text">Subscriptions</span>
                            </div>
                        </button>
                        <button name="action_view_credentials" type="object"
                                class="oe_stat_button" icon="fa-key">
                            <div class="o_stat_info">
                                <span class="o_stat_text">API Keys</span>
                                <field name="credential_count" class="o_stat_value" widget="statinfo"/>
                            </div>
                        </button>
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Invoices</span>
                                <field name="invoice_count" class="o_stat_value" widget="statinfo"/>
                            </div>
                        </button>
                        <button name="action_view_topups" type="object"
                                class="oe_stat_button" icon="fa-arrow-up">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Top-ups</span>
                                <field name="topup_count" class="o_stat_value" widget="statinfo"/>
                            </div>
                        </button>
                        <button name="action_add_topup" type="object"
                                class="oe_stat_button" icon="fa-plus-circle"
                                groups="keykeep.group_manager,keykeep.group_admin,keykeep.group_devops">
                            <div class="o_stat_info">
                                <span class="o_stat_text">+ Top Up</span>
                            </div>
                        </button>
                    </div>
                    
                     <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="flex-shrink-0">
                            <field name="image_1920" widget="image" class="oe_avatar"/>
                        </div>
                        <div class="flex-grow-1">
                            <div class="oe_title">
                                <h1><field name="name" placeholder="Supplier name…"/></h1>
                            </div>
                            <group string="Supplier Identity">
                                <group>
                                    <field name="website" widget="url"/>
                                </group>
                            </group>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="is_company"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="is_keykeep_partner"/>
                        </group>
                        <group>
                            <field name="vat"/>
                        </group>
                    </group>
                    <notebook>
						                   <page name="internal_notes" string="Internal Notes">
                            <field name="comment" placeholder="Internal notes..."/>
                        </page>
	
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Suppliers action -->
    <record id="action_keykeep_suppliers" model="ir.actions.act_window">
        <field name="name">Suppliers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_keykeep_supplier_form"/>
        <field name="domain">[('is_keykeep_partner', '=', True)]</field>
        <field name="context">{'default_is_keykeep_partner': True}</field>
    </record>

    <!-- ===== Keykeep Suppliers Kanban (samma mönster som subscription-kanbanen) ===== -->
    <record id="view_keykeep_supplier_kanban" model="ir.ui.view">
        <field name="name">res.partner.keykeep.supplier.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban default_group_by="billing_model" class="o_kanban_small_column"
                    quick_create="false">
                <field name="name"/>
                <field name="image_1920"/>
                <field name="website"/>
                <field name="billing_model"/>
                <field name="is_keykeep_partner"/>
                <field name="partner_semaphore"/>
                <field name="monthly_forecast_amount"/>
                <field name="company_currency_id"/>
                <field name="subscription_count"/>
                <field name="credential_count"/>
                <field name="invoice_count"/>
                <field name="topup_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click keykeep-card">
                            <div class="keykeep-card-header d-flex align-items-start gap-2">
                                <div class="keykeep-logo flex-shrink-0">
                                    <t t-if="record.image_1920.raw_value">
                                        <field name="image_1920" widget="image" class="keykeep-logo-img"
                                               options="{'preview_image': 'image_1920'}"
                                               alt="Logo"
                                               t-attf-style="width: 48px; height: 48px; border-radius: 8px;"/>
                                    </t>
                                    <t t-else="">
                                        <div class="d-flex align-items-center justify-content-center bg-100 bg-gradient"
                                             style="width: 48px; height: 48px; border-radius: 8px;">
                                            <i class="fa fa-building-o fa-2x text-secondary opacity-50"/>
                                        </div>
                                    </t>
                                </div>
                                <div class="keykeep-title flex-grow-1 min-w-0">
                                    <strong class="d-block text-truncate"><field name="name"/></strong>
                                    <div class="text-muted small text-truncate">
                                        <t t-if="record.website.raw_value">
                                            <field name="website" widget="url"/>
                                        </t>
                                        <t t-else="">
                                            <span>—</span>
                                        </t>
                                    </div>
                                </div>
                                <field name="partner_semaphore" widget="badge"
                                       decoration-success="partner_semaphore == 'green'"
                                       decoration-warning="partner_semaphore == 'yellow'"
                                       decoration-danger="partner_semaphore == 'red'"/>
                            </div>
                            <div class="keykeep-card-body mt-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="keykeep-amount">
                                        <field name="monthly_forecast_amount" widget="monetary"
                                               options="{'currency_field': 'company_currency_id'}"/>
                                        <span class="text-muted">/mån</span>
                                    </span>
                                    <span class="badge text-bg-light">
                                        <field name="billing_model"/>
                                    </span>
                                </div>
                                <div class="text-muted small mt-1">
                                    <t t-esc="record.subscription_count.value"/> subscription(s)
                                </div>
                            </div>
                            <div class="keykeep-card-footer d-flex align-items-center gap-3 mt-2 pt-1 text-muted small">
                                <span t-if="record.credential_count.raw_value &gt; 0" title="API Keys">
                                    <i class="fa fa-key"/> <t t-esc="record.credential_count.value"/>
                                </span>
                                <span t-if="record.invoice_count.raw_value &gt; 0" title="Invoices">
                                    <i class="fa fa-file-text-o"/> <t t-esc="record.invoice_count.value"/>
                                </span>
                                <span t-if="record.topup_count.raw_value &gt; 0" title="Top-ups">
                                    <i class="fa fa-arrow-up"/> <t t-esc="record.topup_count.value"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- OBS: Gamla delete av view_partner_keykeep_form togs bort — xmliden
         no longer exists in the DB, and deleting a missing xmlid crashes
         the module upgrade (drift lesson 2026-08-12). -->
</odoo>
