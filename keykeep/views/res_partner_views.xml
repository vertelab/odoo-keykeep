<odoo>

    <!-- KeyKeep checkbox in the standard form — anchored on the base field company_type
         (independent of bifrost/bifrost_keykeep). Visible only for keykeep groups and
         placed inline on the same row as company_type (radio). -->
    <record id="view_partner_keykeep_checkbox" model="ir.ui.view">
        <field name="name">res.partner.keykeep.checkbox</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="company_type" position="after">
                <div class="d-inline-flex align-items-center"
                     groups="keykeep.group_user,keykeep.group_manager,keykeep.group_devops,keykeep.group_admin"
                     invisible="company_type != 'company'">
                    <field name="is_keykeep_partner"/>
                    <label for="is_keykeep_partner" string="KeyKeep" class="mb-0 ms-1"/>
                </div>
            </field>
        </field>
    </record>

    <!-- ==================================================================
         Suppliers — self-sufficient in keykeep (independent of the
         bifrost_keykeep bridge). Shows partners where is_keykeep_partner
         is set, using only keykeep's own fields (base + keykeep).
         ================================================================== -->

    <!-- Suppliers list -->
    <record id="view_keykeep_supplier_list" model="ir.ui.view">
        <field name="name">res.partner.keykeep.supplier.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Suppliers">
                <field name="name" string="Supplier"/>
                <field name="email"/>
                <field name="is_keykeep_partner" string="KeyKeep"/>
                <field name="subscription_count" string="Subscriptions"/>
            </list>
        </field>
    </record>

    <!-- Suppliers form (self-sufficient: base partner fields + keykeep fields) -->
    <record id="view_keykeep_supplier_form" model="ir.ui.view">
        <field name="name">res.partner.keykeep.supplier.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Supplier">
                <header>
                    <button name="action_fetch_logo" type="object"
                            string="Fetch Logo" class="btn-secondary"
                            help="Auto-fetch logo via web_fetch_logo (logo.dev -> icon.horse -> Google -> scrape)."
                            invisible="not website"/>
                    <button name="action_add_api_key" type="object"
                            string="Add API Key" class="btn-primary" icon="fa-plus"/>
                    <button name="action_add_credential" type="object"
                            string="Add Login" class="btn-secondary" icon="fa-user-plus"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_subscriptions" type="object"
                                class="oe_stat_button" icon="fa-list-alt">
                            <div class="o_stat_info">
                                <field name="subscription_count" widget="statinfo"/>
                                <span class="o_stat_text">Subscriptions</span>
                            </div>
                        </button>
                        <button name="action_view_credentials" type="object"
                                class="oe_stat_button" icon="fa-key">
                            <div class="o_stat_info">
                                <span class="o_stat_text">API Keys</span>
                                <field name="credential_count" class="o_stat_value" widget="statinfo"/>
                            </div>
                        </button>
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Invoices</span>
                                <field name="invoice_count" class="o_stat_value" widget="statinfo"/>
                            </div>
                        </button>
                        <button name="action_view_forecast" type="object"
                                class="oe_stat_button" icon="fa-line-chart">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Forecast</span>
                                <field name="forecast_count" class="o_stat_value" widget="statinfo"/>
                            </div>
                        </button>
                    </div>
                    
                     <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="flex-shrink-0">
                            <field name="image_1920" widget="image" class="oe_avatar"/>
                        </div>
                        <div class="flex-grow-1">
                            <div class="oe_title d-flex align-items-start gap-2">
                                <h1 class="flex-grow-1"><field name="name" placeholder="Supplier name…"/></h1>
                                <field name="partner_semaphore" widget="badge"
                                       decoration-success="partner_semaphore == 'green'"
                                       decoration-warning="partner_semaphore == 'yellow'"
                                       decoration-danger="partner_semaphore == 'red'"/>
                            </div>
                            <group string="Supplier Identity">
                                <group>
                                    <field name="website" widget="url"/>
                                    <field name="user_id" string="Responsible"/>
                                    <field name="keykeep_category_id"/>
                                </group>
                            </group>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="vat"/>
                        </group>
                    </group>
                    <notebook>
						                   <page name="internal_notes" string="Internal Notes">
                            <field name="comment" placeholder="Internal notes..."/>
                        </page>
	
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Suppliers pivot — billing model x monthly forecast -->
    <record id="view_keykeep_supplier_pivot" model="ir.ui.view">
        <field name="name">res.partner.keykeep.supplier.pivot</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="billing_model" type="row"/>
                <field name="is_keykeep_partner" type="col"/>
                <field name="monthly_forecast_amount" type="measure"/>
                <field name="subscription_count" type="measure"/>
                <field name="credential_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Suppliers graph — monthly forecast per billing model -->
    <record id="view_keykeep_supplier_graph" model="ir.ui.view">
        <field name="name">res.partner.keykeep.supplier.graph</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <graph>
                <field name="billing_model" type="row"/>
                <field name="monthly_forecast_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ===== Keykeep Suppliers Kanban (samma mönster som subscription-kanbanen) ===== -->
    <record id="view_keykeep_supplier_kanban" model="ir.ui.view">
        <field name="name">res.partner.keykeep.supplier.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban default_group_by="keykeep_category_id" class="o_kanban_small_column"
                    color_field="keykeep_category_id" quick_create="false">
                <field name="name"/>
                <field name="image_1920"/>
                <field name="user_id"/>
                <field name="website"/>
                <field name="billing_model"/>
                <field name="is_keykeep_partner"/>
                <field name="keykeep_category_id"/>
                <field name="partner_semaphore"/>
                <field name="next_renewal_date"/>
                <field name="days_until_renewal"/>
                <field name="monthly_forecast_amount"/>
                <field name="company_currency_id"/>
                <field name="subscription_count"/>
                <field name="credential_count"/>
                <field name="invoice_count"/>
                <field name="forecast_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click keykeep-card">
                            <div class="keykeep-card-header d-flex align-items-start gap-2">
                                <div class="keykeep-logo flex-shrink-0">
                                    <t t-if="record.image_1920.raw_value">
                                        <field name="image_1920" widget="image" class="keykeep-logo-img"
                                               options="{'preview_image': 'image_1920'}"
                                               alt="Logo"
                                               t-attf-style="width: 48px; height: 48px; border-radius: 8px;"/>
                                    </t>
                                    <t t-else="">
                                        <div class="d-flex align-items-center justify-content-center bg-100 bg-gradient"
                                             style="width: 48px; height: 48px; border-radius: 8px;">
                                            <i class="fa fa-building-o fa-2x text-secondary opacity-50" title="Logo"/>
                                        </div>
                                    </t>
                                </div>
                                <div class="keykeep-title flex-grow-1 min-w-0">
                                    <strong class="d-block text-truncate"><field name="name"/></strong>
                                    <div class="text-muted small text-truncate">
                                        <t t-if="record.website.raw_value">
                                            <field name="website" widget="url"/>
                                        </t>
                                        <t t-else="">
                                            <span>—</span>
                                        </t>
                                    </div>
                                </div>
                                <field name="user_id" widget="many2one_avatar"
                                       class="o_kanban_avatar"
                                       options="{'display_name': True}"/>
                                <field name="partner_semaphore" widget="badge"
                                       decoration-success="partner_semaphore == 'green'"
                                       decoration-warning="partner_semaphore == 'yellow'"
                                       decoration-danger="partner_semaphore == 'red'"/>
                            </div>
                            <div class="keykeep-card-body mt-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="keykeep-amount">
                                        <field name="monthly_forecast_amount" widget="monetary"
                                               options="{'currency_field': 'company_currency_id'}"/>
                                        <span class="text-muted">/mån</span>
                                    </span>
                                    <span class="badge text-bg-light">
                                        <field name="billing_model"/>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <span class="text-muted small">Next:</span>
                                    <span t-attf-class="keykeep-days #{record.partner_semaphore.raw_value}">
                                        <t t-if="record.next_renewal_date.raw_value">
                                            <t t-if="record.days_until_renewal.value &lt; 0">
                                                <span class="text-danger">⚠ <field name="next_renewal_date"/> Overdue</span>
                                            </t>
                                            <t t-elif="record.days_until_renewal.value == 0">
                                                <span class="text-warning">⏰ <field name="next_renewal_date"/> Today</span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-info"><field name="next_renewal_date"/> (<t t-esc="record.days_until_renewal.value"/> dagar)</span>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <span class="text-muted">—</span>
                                        </t>
                                    </span>
                                </div>
                            </div>
                            <div class="keykeep-card-footer d-flex justify-content-between align-items-center mt-2 pt-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge text-bg-light" t-if="record.keykeep_category_id.raw_value">
                                        <a type="action" name="keykeep.action_keykeep_category">
                                            <field name="keykeep_category_id"/>
                                        </a>
                                    </span>
                                </div>
                                <div class="d-flex align-items-center gap-2 text-muted small">
                                    <a type="object" name="action_view_subscriptions" title="Subscriptions">
                                        <i class="fa fa-list-alt"/> <t t-esc="record.subscription_count.value"/>
                                    </a>
                                    <a type="object" name="action_view_credentials"
                                       t-if="record.credential_count.raw_value &gt; 0" title="API Keys">
                                        <i class="fa fa-key"/> <t t-esc="record.credential_count.value"/>
                                    </a>
                                    <a type="object" name="action_view_invoices"
                                       t-if="record.invoice_count.raw_value &gt; 0" title="Invoices">
                                        <i class="fa fa-file-text-o"/> <t t-esc="record.invoice_count.value"/>
                                    </a>
                                    <a type="object" name="action_view_forecast"
                                       t-if="record.forecast_count.raw_value &gt; 0" title="Forecast">
                                        <i class="fa fa-line-chart"/> <t t-esc="record.forecast_count.value"/>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Suppliers action (efter vyerna — undviker framåtreferens) -->
    <record id="action_keykeep_suppliers" model="ir.actions.act_window">
        <field name="name">Suppliers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,pivot,graph,form</field>
        <field name="view_id" eval="False"/>
        <field name="domain">[('is_keykeep_partner', '=', True)]</field>
        <field name="context">{'default_is_keykeep_partner': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'sequence': 10, 'view_mode': 'kanban', 'view_id': ref('view_keykeep_supplier_kanban')}),
            (0, 0, {'sequence': 20, 'view_mode': 'list', 'view_id': ref('view_keykeep_supplier_list')}),
            (0, 0, {'sequence': 30, 'view_mode': 'pivot', 'view_id': ref('view_keykeep_supplier_pivot')}),
            (0, 0, {'sequence': 40, 'view_mode': 'graph', 'view_id': ref('view_keykeep_supplier_graph')}),
            (0, 0, {'sequence': 50, 'view_mode': 'form', 'view_id': ref('view_keykeep_supplier_form')}),
        ]"/>
    </record>

    <!-- OBS: Gamla delete av view_partner_keykeep_form togs bort — xmliden
         no longer exists in the DB, and deleting a missing xmlid crashes
         the module upgrade (drift lesson 2026-08-12). -->

    <!-- Filter på Kontakter-sökvyn (res.partner): Keykeep-partners -->
    <record id="view_partner_keykeep_search" model="ir.ui.view">
        <field name="name">res.partner.keykeep.search</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <filter name="type_company" position="after">
                <filter string="Keykeep" name="keykeep_partner"
                        domain="[('is_keykeep_partner', '=', True)]"/>
            </filter>
        </field>
    </record>
</odoo>
