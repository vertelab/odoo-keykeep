<odoo>
    <!-- ===== Subscription Kanban View ===== -->
    <record id="view_keykeep_subscription_kanban" model="ir.ui.view">
        <field name="name">keykeep.subscription.kanban</field>
        <field name="model">keykeep.subscription</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id" class="o_kanban_small_column"
                    color_field="category_id" quick_create="false">
                <field name="name"/>
                <field name="logo"/>
                <field name="partner_id"/>
                <field name="category_id"/>
                <field name="contract_type"/>
                <field name="state"/>
                <field name="active"/>
                <field name="renewal_semaphore"/>
                <field name="renewal_frequency"/>
                <field name="responsible_id"/>
                <field name="monthly_forecast_amount"/>
                <field name="company_currency_id"/>
                <field name="next_renewal_date"/>
                <field name="days_until_renewal"/>
                <field name="credential_count"/>
                <field name="invoice_count"/>
                <field name="forecast_count"/>
                <field name="topup_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click keykeep-card">
                            <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                                    invisible="active"/>
                            <div class="keykeep-card-header d-flex align-items-start gap-2">
                                <div class="keykeep-logo flex-shrink-0">
                                    <t t-if="record.logo.raw_value">
                                        <field name="logo" widget="image" class="keykeep-logo-img"
                                               options="{'img_class': 'object-fit-cover'}"
                                               alt="Logo"
                                               t-attf-style="width: 48px; height: 48px; border-radius: 8px;"/>
                                    </t>
                                    <t t-else="">
                                        <div class="d-flex align-items-center justify-content-center bg-100 bg-gradient"
                                             style="width: 48px; height: 48px; border-radius: 8px;">
                                            <i class="fa fa-cubes fa-2x text-secondary opacity-50"/>
                                        </div>
                                    </t>
                                </div>
                                <div class="keykeep-title flex-grow-1 min-w-0">
                                    <strong class="d-block text-truncate"><field name="name"/></strong>
                                    <div class="text-muted small text-truncate">
                                        <field name="partner_id"/>
                                    </div>
                                </div>
                                <field name="renewal_semaphore" widget="badge"
                                       decoration-success="renewal_semaphore == 'green'"
                                       decoration-warning="renewal_semaphore == 'yellow'"
                                       decoration-danger="renewal_semaphore == 'red'"/>
                                <field name="responsible_id" widget="many2one_avatar"
                                       class="o_kanban_avatar"
                                       options="{'display_name': True}"/>
                            </div>
                            <div class="keykeep-card-body mt-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="keykeep-amount">
                                        <field name="monthly_forecast_amount" widget="monetary"
                                               options="{'currency_field': 'company_currency_id'}"/>
                                        <span class="text-muted">/mån</span>
                                    </span>
                                    <span class="badge text-bg-light">
                                        <field name="renewal_frequency"/>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <span class="text-muted small">Next:</span>
                                    <span t-attf-class="keykeep-days #{record.renewal_semaphore.raw_value}">
                                        <t t-if="record.state.raw_value == 'active' and record.days_until_renewal.raw_value != null">
                                            <t t-if="record.days_until_renewal.value &lt; 0">
                                                <span class="text-danger">⚠ <field name="next_renewal_date"/> Overdue</span>
                                            </t>
                                            <t t-elif="record.days_until_renewal.value == 0">
                                                <span class="text-warning">⏰ <field name="next_renewal_date"/> Today</span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-info"><field name="next_renewal_date"/> (<t t-esc="record.days_until_renewal.value"/> dagar)</span>
                                            </t>
                                        </t>
                                        <t t-if="record.state.raw_value == 'cancelled'">
                                            <span class="text-muted">Cancelled</span>
                                        </t>
                                        <t t-if="record.state.raw_value == 'expired'">
                                            <span class="text-danger">Expired</span>
                                        </t>
                                    </span>
                                </div>
                            </div>
                            <div class="keykeep-card-footer d-flex justify-content-between align-items-center mt-2 pt-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge text-bg-secondary"><field name="contract_type"/></span>
                                    <span class="badge text-bg-light" t-if="record.category_id.raw_value">
                                        <field name="category_id"/>
                                    </span>
                                </div>
                                <div class="d-flex align-items-center gap-2 text-muted small">
                                    <span t-if="record.credential_count.raw_value &gt; 0" title="API Keys">
                                        <i class="fa fa-key"/> <t t-esc="record.credential_count.value"/>
                                    </span>
                                    <span t-if="record.invoice_count.raw_value &gt; 0" title="Invoices">
                                        <i class="fa fa-file-text-o"/> <t t-esc="record.invoice_count.value"/>
                                    </span>
                                    <span t-if="record.forecast_count.raw_value &gt; 0" title="Forecast">
                                        <i class="fa fa-line-chart"/> <t t-esc="record.forecast_count.value"/>
                                    </span>
                                    <span t-if="record.topup_count.raw_value &gt; 0 and (record.contract_type.raw_value == 'top_up' or record.contract_type.raw_value == 'subscription_plus_topup')" title="Top-ups">
                                        <i class="fa fa-arrow-up"/> <t t-esc="record.topup_count.value"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ===== Subscription Tree View ===== -->
    <record id="view_keykeep_subscription_tree" model="ir.ui.view">
        <field name="name">keykeep.subscription.tree</field>
        <field name="model">keykeep.subscription</field>
        <field name="arch" type="xml">
            <list default_order="next_renewal_date asc">
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="category_id" optional="show"/>
                <field name="cost_amount" sum="Total" groups="keykeep.group_manager"/>
                <field name="currency_id" optional="hide" groups="keykeep.group_manager"/>
                <field name="renewal_frequency" optional="hide"/>
                <field name="next_renewal_date" decoration-danger="kanban_state == 'critical'" decoration-warning="kanban_state == 'warning'" decoration-muted="state != 'active'"/>
                <field name="days_until_renewal" optional="show"/>
                <field name="state"/>
                <field name="responsible_id" optional="show"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ===== Subscription Form View ===== -->
    <record id="view_keykeep_subscription_form" model="ir.ui.view">
        <field name="name">keykeep.subscription.form</field>
        <field name="model">keykeep.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <button name="action_fetch_logo" type="object"
                            string="Fetch Logo" class="btn-secondary"
                            help="Auto-fetch logo from Clearbit using the service URL."
                            invisible="not url"/>
                            
                            <button name="action_add_api_key" type="object"
                        string="Add API Key" class="btn-primary" icon="fa-plus"/>
                <button name="action_add_credential" type="object"
                        string="Add Credential" class="btn-secondary" icon="fa-user-plus"/>
                            
                    <field name="state" widget="statusbar"
                            statusbar_visible="active,cancelled,expired"
                            clickable="True"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_credentials" type="object" class="oe_stat_button" icon="fa-key">
                            <div class="o_stat_info">
<!--
                                <span class="o_stat_text">API Keys</span>
-->
                                <field name="credential_count" class="o_stat_value" widget="statinfo" />
                            </div>
                        </button>
                        
                        
                      
                        
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_stat_info">
<!--
                                <span class="o_stat_text">Invoices</span>
-->
                                <field name="invoice_count" class="o_stat_value" widget="statinfo"  />
                            </div>
                        </button>
                        <button name="action_view_forecast" type="object"
                                class="oe_stat_button" icon="fa-line-chart">
                            <div class="o_stat_info">
<!--
                                <span class="o_stat_text">Forecast</span>
-->
                                <field name="forecast_count" class="o_stat_value" widget="statinfo" />
                            </div>
                        </button>
                        <button name="action_view_topups" type="object" invisible="contract_type not in ['top_up','subscription_plus_topup']"
                                class="oe_stat_button" icon="fa-arrow-up">
                            <div class="o_stat_info">
<!--
                                <span class="o_stat_text">Top-ups</span>
-->
                                <field name="topup_count" class="o_stat_value" widget="statinfo" no-label="1"/>
                            </div>
                        </button>
                        <button name="action_add_topup" type="object"  invisible="contract_type not in ['top_up','subscription_plus_topup']"
                                class="oe_stat_button" icon="fa-plus-circle"
                                groups="keykeep.group_manager,keykeep.group_admin,keykeep.group_devops">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Top-up</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <div class="d-flex align-items-center mb-3">
                            <field name="logo" widget="image" class="oe_avatar me-3"
                                   options="{'size': [64, 64]}"/>
                            <h1 class="me-3"><field name="name" placeholder="e.g. Slack, GitHub Enterprise"/></h1>
                            <field name="renewal_semaphore" widget="badge"
                                   decoration-success="renewal_semaphore == 'green'"
                                   decoration-warning="renewal_semaphore == 'yellow'"
                                   decoration-danger="renewal_semaphore == 'red'"/>
                        </div>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                                invisible="active"/>
                    </div>

                    <!-- Supplier overview (between name and notebook) -->
                    <group>
                        <group>
                            <field name="partner_id" string="Supplier"/>
                            <field name="category_id"/>
                            <field name="responsible_id"/>
                            
                            <field name="url" string="Service URL" widget="url"/>
                        </group>
                        <group>
                        <field name="contract_type"/>
                        <field name="replacement_subscription_id"
                                   domain="[('id', '!=', id)]"/>
                       
                        </group>
                    </group>

                    <notebook>

                        <!-- Tab 2: Renewal (semaforsgrund) -->
                        <page string="Renewal" name="renewal">
                            <group>
                                <group>
                                    <field name="start_date"/>
                                    <field name="next_renewal_date"/>
                                    <field name="renewal_frequency"/>
                                    <field name="renewal_cycle" invisible="renewal_frequency == 'monthly'"/>
                                    <field name="billing_model"/>
                                </group>
                                <group invisible="contract_type not in ['subscription','subscription_plus_topup']">
                                    <field name="auto_renew"/>
                                    <field name="notify_days_before"/>
                                    <field name="cancellation_date"
                                           invisible="state != 'cancelled'"/>
                                           
                                           					 <field name="currency_id" />
                                    <field name="cost_amount"  class="o_input_13ch" widget='monetary' options="{'currency_field': 'currency_id'}" /> 
                                           
                  
                                    <field name="payment_method_id"/>
                                           
                                </group>
                            </group>

                            <!-- Balance and Forecast — owned by keykeep -->
                            <group>
                                <group string="Balance" invisible="contract_type not in ['top_up','subscription_plus_topup']">
                                    <div class="d-flex align-items-center gap-2">
                                        <label for="last_balance"/>
                                        <field name="last_balance"
                                               widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        
                                    </div>
                                    <field name="last_balance_checked_at" readonly="1"/>
                                </group>
                                <group string="Forecast" invisible="contract_type not in ['top_up','subscription_plus_topup']">
                                       <field name="burn_rate_day"
                                               widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="days_until_empty"/>
                                    <field name="projected_empty_date"/>
                                </group>
                        </group>
                        </page>
                        
                                              

                        <!-- Tab: Notes -->
                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===== Subscription Calendar View ===== -->
    <record id="view_keykeep_subscription_calendar" model="ir.ui.view">
        <field name="name">keykeep.subscription.calendar</field>
        <field name="model">keykeep.subscription</field>
        <field name="arch" type="xml">
            <calendar date_start="next_renewal_date" color="category_id">
                <field name="name"/>
                <field name="partner_id"/>
            </calendar>
        </field>
    </record>

    <!-- ===== Subscription Pivot View ===== -->
    <record id="view_keykeep_subscription_pivot" model="ir.ui.view">
        <field name="name">keykeep.subscription.pivot</field>
        <field name="model">keykeep.subscription</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="category_id" type="row"/>
                <field name="partner_id" type="col"/>
                <field name="monthly_forecast_amount" type="measure"/>
                <field name="cost_amount" type="measure"/>
                <field name="currency_id" type="col"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- ===== Subscription Graph View ===== -->
    <record id="view_keykeep_subscription_graph" model="ir.ui.view">
        <field name="name">keykeep.subscription.graph</field>
        <field name="model">keykeep.subscription</field>
        <field name="arch" type="xml">
            <graph>
                <field name="category_id" type="row"/>
                <field name="cost_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ===== Subscription Search View ===== -->
    <record id="view_keykeep_subscription_search" model="ir.ui.view">
        <field name="name">keykeep.subscription.search</field>
        <field name="model">keykeep.subscription</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="category_id"/>
                <field name="responsible_id"/>
                <separator/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter name="renewal_ok" string="Semaphore: OK"
                        domain="[('renewal_semaphore', '=', 'green')]"/>
                <filter name="renewal_warning" string="Semaphore: Warning"
                        domain="[('renewal_semaphore', '=', 'yellow')]"/>
                <filter name="renewal_critical" string="Semaphore: Critical"
                        domain="[('renewal_semaphore', '=', 'red')]"/>
                <separator/>
                <filter name="contract_subscription" string="Subscription"
                        domain="[('contract_type', '=', 'subscription')]"/>
                <filter name="contract_topup" string="Top-up"
                        domain="[('contract_type', '=', 'top_up')]"/>
                <filter name="contract_plus" string="Subscription + Top-up"
                        domain="[('contract_type', '=', 'subscription_plus_topup')]"/>
                <separator/>
                <filter name="auto_renew" string="Auto Renew"
                        domain="[('auto_renew', '=', True)]"/>
                <filter name="low_balance" string="Low Balance"
                        domain="[('last_balance', '!=', False), ('budget_limit', '>', 0), ('last_balance', '&lt;=', 'budget_limit * 0.2')]"/>
                <filter name="empty_soon" string="Empty Soon"
                        domain="[('days_until_empty', '&lt;=', 10), ('days_until_empty', '&gt;', 0)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category"
                            domain="[]" context="{'group_by': 'category_id'}"/>
                    <filter name="group_contract" string="Contract Type"
                            domain="[]" context="{'group_by': 'contract_type'}"/>
                    <filter name="group_partner" string="Supplier"
                            domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="State"
                            domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_renewal" string="Renewal Frequency"
                            domain="[]" context="{'group_by': 'renewal_frequency'}"/>
                    <filter name="group_responsible" string="Responsible"
                            domain="[]" context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===== Subscription Action (Main Window) ===== -->
    <record id="action_keykeep_subscription" model="ir.actions.act_window">
        <field name="name">SaaS Subscriptions</field>
        <field name="res_model">keykeep.subscription</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph</field>
        <field name="search_view_id" ref="view_keykeep_subscription_search"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <!-- ===== Server Action: Create Journal Entry ===== -->
    <record id="action_create_journal_entry_wizard" model="ir.actions.act_window">
        <field name="name">Create Journal Entry</field>
        <field name="res_model">keykeep.create.journal.entry</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_keykeep_subscription"/>
        <field name="binding_view_types">form</field>
    </record>

    <!-- ===== Server Action: Recompute Monthly Forecast ===== -->
    <!-- Kugghjul / context action: recompute stored monthly_forecast_amount
         after currency or forecast changes (e.g. company currency switched). -->
    <record id="action_recompute_monthly_forecast" model="ir.actions.server">
        <field name="name">Generate &amp; Recompute Forecast</field>
        <field name="model_id" ref="model_keykeep_subscription"/>
        <field name="binding_model_id" ref="model_keykeep_subscription"/>
        <field name="binding_view_types">list,kanban,form</field>
        <field name="state">code</field>
        <field name="code">
# 1) Generate the rolling 12-month forecast rows (if not already present)
res = env['keykeep.cost.forecast'].generate_forecast(months=12)

# 2) Recompute the stored monthly forecast amounts
records = env['keykeep.subscription'].search([])
records._compute_monthly_forecast_amount()
records.flush_recordset()

# User notification with summary
action = {
    'type': 'ir.actions.client',
    'tag': 'display_notification',
    'params': {
        'title': 'Forecast generated',
        'message': f"Created {res['created']} rows, updated {res['updated']}; "
                   f"recomputed {len(records)} subscriptions.",
        'type': 'success',
        'sticky': False,
    },
}
</field>
    </record>
</odoo>
