<!-- Adds the fullscreen/expand icon (fa-expand, same as calendar.event's
     FormViewDialog) to act_window form dialogs opened via target="new"
     (ActionDialog). Clicking it re-opens the record as a main-area form
     action — see ActionDialog.onExpand in keykeep.js. -->
<templates xml:space="preserve">

    <t t-name="keykeep.ActionDialog.header" t-inherit="web.ActionDialog.header" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('btn-close')]" position="before">
            <button t-if="props.actionType === 'ir.actions.act_window' and props.actionProps?.type === 'form'"
                    type="button" class="fa fa-expand btn o_expand_button"
                    aria-label="Expand" tabindex="-1" t-on-click="onExpand"/>
        </xpath>
    </t>

</templates>
