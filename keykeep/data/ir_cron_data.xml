<odoo>
    <data noupdate="1">
        <!-- Cron: Update renewal dates (daily at 2:00 AM) -->
        <record id="cron_update_renewal_dates" model="ir.cron">
            <field name="name">Keykeep: Update Renewal Dates</field>
            <field name="model_id" ref="model_keykeep_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_renewal_dates()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: Send renewal notifications (daily at 8:00 AM) -->
        <record id="cron_send_renewal_notifications" model="ir.cron">
            <field name="name">Keykeep: Send Renewal Notifications</field>
            <field name="model_id" ref="model_keykeep_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_renewal_notifications()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: Check credential expiry (daily at 9:00 AM) -->
        <record id="cron_check_credential_expiry" model="ir.cron">
            <field name="name">Keykeep: Check Credential Expiry</field>
            <field name="model_id" ref="model_keykeep_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_credential_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: Check credential rotation health (daily at 9:30 AM) -->
        <record id="cron_check_credential_rotation" model="ir.cron">
            <field name="name">Keykeep: Check Credential Rotation Health</field>
            <field name="model_id" ref="model_keykeep_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_credential_rotation()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: Cleanup old access logs (daily at 3:00 AM) -->
        <record id="cron_cleanup_access_logs" model="ir.cron">
            <field name="name">Keykeep: Cleanup Old Access Logs</field>
            <field name="model_id" ref="model_keykeep_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_access_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: Purge old credential versions (daily at 3:15 AM) -->
        <record id="cron_purge_credential_versions" model="ir.cron">
            <field name="name">Keykeep: Purge Old Credential Versions</field>
            <field name="model_id" ref="model_keykeep_credential"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_credential_versions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: Generate cost forecast (weekly, admin i Settings) -->
        <record id="cron_generate_cost_forecast" model="ir.cron">
            <field name="name">Keykeep: Generate Cost Forecast</field>
            <field name="model_id" ref="model_keykeep_cost_forecast"/>
            <field name="state">code</field>
            <field name="code">model.generate_forecast(months=12)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
