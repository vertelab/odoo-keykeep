<odoo>
    <!-- Create Credential Wizard View -->
    <record id="view_keykeep_credential_create_wizard" model="ir.ui.view">
        <field name="name">keykeep.credential.create.wizard.form</field>
        <field name="model">keykeep.credential.create.wizard</field>
        <field name="arch" type="xml">
            <form string="New Credential">
                <sheet>
                    <div class="oe_title mb-4">
                        <h3>New Credential</h3>
                    </div>

                    <!-- Step 1: What -->
                    <group string="1. What is it?">
                        <group>
                            <field name="subscription_id" invisible="1"/>
                            <field name="name" placeholder="e.g. Production API Key"/>
                            <field name="credential_type"/>
                            <field name="environment" widget="radio"/>
                        </group>
                    </group>

                    <!-- Step 2: The Secret -->
                    <group string="2. The Secret"
                           invisible="credential_type == 'certificate'">
                        <!-- API Key / Token / Other -->
                        <group invisible="credential_type not in ('api_key', 'token', 'other')">
                            <field name="key_value" widget="text"
                                   placeholder="Paste your API key or token here..."/>
                            <div class="text-muted small mb-2">
                                <span class="keykeep-key-detect" id="key_detect"/>
                            </div>
                        </group>
                        <!-- Login -->
                        <group invisible="credential_type != 'login'">
                            <field name="username" placeholder="Username or email"/>
                            <label for="password"/>
                            <div class="d-flex">
                                <field name="password" password="True"
                                       placeholder="Password (will be encrypted)" class="flex-grow-1"/>
                                <button name="action_generate_password" type="object"
                                        string="Generate" class="btn-secondary ms-2"
                                        icon="fa-random"
                                        help="Generate a strong random password"/>
                            </div>
                        </group>
                        <!-- Certificate -->
                        <group invisible="credential_type != 'certificate'">
                            <field name="key_value" widget="text"
                                   placeholder="Paste your certificate (PEM, CRT, etc.)..."/>
                        </group>
                    </group>

                    <!-- Step 3: Details (optional) -->
                    <group string="3. Details (optional)">
                        <group>
                            <field name="purpose" placeholder="e.g. CI/CD pipeline deployment"/>
                            <field name="expiry_date"/>
                            <field name="renewal_reminder"/>
                        </group>
                        <group>
                            <field name="notes" placeholder="Any additional notes..."/>
                        </group>
                    </group>

                    <footer>
                        <button name="action_create" type="object"
                                string="Save Credential" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_keykeep_credential_create_wizard" model="ir.actions.act_window">
        <field name="name">New Credential</field>
        <field name="res_model">keykeep.credential.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
