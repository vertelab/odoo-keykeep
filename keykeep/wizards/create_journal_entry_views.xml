<odoo>
    <!-- Create Journal Entry Wizard Form -->
    <record id="view_create_journal_entry_wizard_form" model="ir.ui.view">
        <field name="name">keykeep.create.journal.entry.form</field>
        <field name="model">keykeep.create.journal.entry</field>
        <field name="arch" type="xml">
            <form string="Create Journal Entry">
                <group>
                    <group>
                        <field name="subscription_id" invisible="1"/>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="amount"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="expense_account_id"/>
                        <field name="partner_id" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_entry" type="object"
                            string="Create Entry" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <!-- Reveal Credential Wizard Form -->
    <record id="view_credential_reveal_form" model="ir.ui.view">
        <field name="name">keykeep.credential.reveal.form</field>
        <field name="model">keykeep.credential.reveal</field>
        <field name="arch" type="xml">
            <form string="Reveal Credential">
                <!-- Audit Warning -->
                <div class="alert alert-warning mb-2" role="alert">
                    <strong>⚠️ This access is logged</strong><br/>
                    User: <field name="audit_user" nolabel="1" class="d-inline"/><br/>
                    Time: <field name="audit_time" nolabel="1" class="d-inline"/>
                </div>

                <!-- Credential Context -->
                <group>
                    <field name="credential_id" invisible="1"/>
                    <field name="subscription"/>
                    <field name="credential_name"/>
                    <field name="credential_type"/>
                    <field name="environment" widget="badge"/>
                    <field name="username" invisible="credential_type != 'login'"/>
                </group>

                <!-- Decrypted Value -->
                <group string="Value">
                    <!-- Login: e-mail + password with copy buttons -->
                    <group invisible="credential_type != 'login'">
                        <field name="email" string="E-mail" readonly="1"/>
                        <field name="password" string="Password" readonly="1" password="True"/>
                        <div class="d-flex gap-2 mt-2">
                            <a href="javascript:void(0)" class="btn btn-sm btn-outline-secondary"
                               data-keykeep-copy="email" title="Copy e-mail">
                                <i class="fa fa-copy"/> Copy E-mail
                            </a>
                            <a href="javascript:void(0)" class="btn btn-sm btn-outline-secondary"
                               data-keykeep-copy="password" title="Copy password">
                                <i class="fa fa-copy"/> Copy Password
                            </a>
                        </div>
                    </group>
                    <!-- API key / token with copy button -->
                    <group invisible="credential_type not in ('api_key','token','other')">
                        <field name="api_key" string="API Key / Token" readonly="1" widget="text"/>
                        <div class="d-flex gap-2 mt-2">
                            <a href="javascript:void(0)" class="btn btn-sm btn-outline-secondary"
                               data-keykeep-copy="api_key" title="Copy API key">
                                <i class="fa fa-copy"/> Copy Key
                            </a>
                        </div>
                    </group>
                </group>
                <group string="Raw" invisible="not decrypted_value">
                    <field name="decrypted_value" nolabel="1" colspan="2"
                           widget="text" invisible="not decrypted_value"/>
                </group>

                <!-- Last Access Info -->
                <group string="Last Access" colspan="2">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">By: <field name="last_accessed_by" nolabel="1" class="d-inline"/></span>
                        <span class="text-muted">At: <field name="last_accessed_at" nolabel="1" class="d-inline"/></span>
                    </div>
                </group>

                <!-- Recent Access History -->
                <group string="Recent Access History" invisible="not recent_access" colspan="2">
                    <field name="recent_access" nolabel="1" colspan="2"/>
                </group>

                <!-- Auto-close info -->
                <div class="text-muted small text-center mb-2">
                    This window will auto-close in <field name="reveal_timeout" nolabel="1" class="d-inline"/> seconds
                </div>

                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
