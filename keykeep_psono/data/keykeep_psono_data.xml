<odoo>
    <data>
        <!-- Runtime configuration defaults (non-secret).
             The server identity keys are NOT stored here — they live in
             odoo.conf / env / keys file (see config.py + hooks.py). -->
        <record id="psono_config_replay_window" model="ir.config_parameter">
            <field name="key">keykeep_psono.replay_window_seconds</field>
            <field name="value">20</field>
        </record>
        <record id="psono_config_registration" model="ir.config_parameter">
            <field name="key">keykeep_psono.allow_registration</field>
            <field name="value">1</field>
        </record>
        <record id="psono_config_token_valid" model="ir.config_parameter">
            <field name="key">keykeep_psono.token_valid_seconds</field>
            <field name="value">2592000</field>
        </record>

        <!-- Client configuration flags (design D1/D2). Global policy is read
             from these; personal values (language) come from the session.
             allow_custom_server is a SECURITY flag and must never become
             per-user. -->
        <record id="psono_config_allow_lost_password" model="ir.config_parameter">
            <field name="key">keykeep_psono.allow_lost_password</field>
            <field name="value">1</field>
        </record>
        <record id="psono_config_allow_delete_account" model="ir.config_parameter">
            <field name="key">keykeep_psono.allow_delete_account</field>
            <field name="value">0</field>
        </record>
        <record id="psono_config_allow_custom_server" model="ir.config_parameter">
            <field name="key">keykeep_psono.allow_custom_server</field>
            <field name="value">1</field>
        </record>
        <record id="psono_config_require_email_verification" model="ir.config_parameter">
            <field name="key">keykeep_psono.require_email_verification_for_web</field>
            <field name="value">1</field>
        </record>
    </data>
</odoo>
